server {
    listen 443 ssl;
    http2 on;
    server_name entity-state-api.luminal.local;

    ssl_certificate /etc/nginx/certs/entity-state-api.luminal.local.pem;
    ssl_certificate_key /etc/nginx/certs/entity-state-api.luminal.local-key.pem;

    client_max_body_size 2m;

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_pass http://127.0.0.1:8390;
    }

    location /health {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8390;
    }
}

server {
    listen 80;
    server_name entity-state-api.luminal.local;
    return 301 https://$host$request_uri;
}
